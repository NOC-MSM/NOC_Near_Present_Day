#!/bin/bash

# Set environment
module load PrgEnv-cray/8.6.0 
module load cray-hdf5-parallel/1.14.3.5 
module load cray-netcdf-hdf5parallel/4.9.0.17

module list
export OMP_NUM_THREADS=1

# Compile tools
while read -r LINE; do
  CFG=${LINE%% *}
  ./makenemo -m X86_CIRRUS-Cray-xios3 -j 16 -r "$CFG" || exit
done <cfgs/work_cfgs.txt
